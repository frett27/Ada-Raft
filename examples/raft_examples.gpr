with "config/raft_examples_config.gpr";

project Raft_Examples is

   for Source_Dirs use ("src/");
   for Object_Dir use "obj/" & Raft_Examples_Config.Build_Profile;
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("raft_server.adb", "raft_client.adb");

   package Compiler is
      for Default_Switches ("Ada") use Raft_Examples_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Raft_Examples;
