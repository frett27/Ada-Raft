with "config/raft_config.gpr";
project Raft is

   for Library_Name use "Raft";
   for Library_Version use Project'Library_Name & ".so." & Raft_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Raft_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("RAFT_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Raft_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Pretty_Printer is
      for Default_Switches ("Ada") use
        ("-i3", "-M79", "-w", "-nU", "-kL");
   end Pretty_Printer;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=1", "--timeout=60", "--steps=0");
   end Prove;

end Raft;
